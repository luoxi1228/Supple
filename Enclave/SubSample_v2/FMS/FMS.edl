enclave {
    trusted {
        public int FMSCompactPrepare(
            [in, size=n] uint8_t *routing_tags,
            size_t n,
            size_t n_left,
            size_t n_right,
            [out] size_t *control_words,
            [out] double *control_us);

        public double FMSCompactOnline(
            [user_check] unsigned char *buffer,
            size_t n,
            size_t block_size);

        public double OCompactOnline(
            [user_check] unsigned char *buffer,
            size_t n,
            size_t block_size);

        public void FMSCompactRelease(void);
    };
};
