enclave {
    trusted {
        public int FMSPrepare(
            [in, size=n] uint8_t *routing_tags,
            size_t n,
            [out] size_t *control_words);

        public double FMSApplyOnline(
            [user_check] unsigned char *buffer,
            size_t n,
            size_t block_size);

        public double TwoCompactOnline(
            [user_check] unsigned char *left_buffer,
            [user_check] unsigned char *right_buffer,
            size_t n,
            size_t block_size);

        public void FMSRelease(void);
    };
};
